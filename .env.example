# Copie ce fichier en « .env » et remplis les valeurs.
# Ce fichier-ci est un modele : il ne contient aucun secret.

# ---- Le compte du bot ----
BOT_USERNAME=aminabot_
CHANNEL=saysayouu

# ---- Application Twitch ----
# A creer sur https://dev.twitch.tv/console/apps
#   URL de redirection OAuth : http://localhost:3000   (en entier, avec http://)
#   Type de client           : Confidentiel            (sinon pas de secret)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Rempli par `npm run token` : connecte-toi alors avec le compte du BOT.
# C'est lui qui permet au bot de renouveler son acces tout seul.
TWITCH_REFRESH_TOKEN=

# ---- Repli ----
# Jeton fixe (https://twitchapps.com/tmi/). Utilise uniquement si les trois
# variables ci-dessus ne sont pas toutes remplies. Expire en quelques heures.
BOT_OAUTH=

# ---- Convex ----
# CONVEX_URL / VITE_CONVEX_URL sont ecrites automatiquement dans .env.local
# par `npx convex dev`. Rien a faire ici.
